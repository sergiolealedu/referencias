{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/**/*"],
  "references": [{ "path": "../shared" }],
  // Teste é colocado ao lado do código, mas não vai para o dist publicado.
  // A verificação de tipos dos testes fica em tsconfig.test.json.
  "exclude": ["**/*.test.ts"]
}
