# Sem isto o Git avisa "LF will be replaced by CRLF" em todo commit feito no
# Windows e o mesmo arquivo pode chegar ao repositório com final de linha
# diferente dependendo de quem commitou.
* text=auto eol=lf

# Scripts que o Linux executa: LF é obrigatório, um CRLF quebra o shebang.
*.sh text eol=lf
*.py text eol=lf

# PowerShell e batch rodam no Windows.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binários: nunca converter.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.jks binary
*.keystore binary
*.apk binary
*.aab binary
*.db binary
